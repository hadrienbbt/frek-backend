rules_version = '2';

// Only the backend uses this database, through the Firebase Admin SDK, which
// security rules do not apply to. Clients such as the iOS app read the data
// through GET /gym. Direct client access is therefore denied, so nobody can
// read, change or delete the data with the public project id.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
